# Cursor worker (worker.kind = "cursor", the default). cursor.com/dashboard → API Keys.
CURSOR_API_KEY=key_xxx

# Claude Code worker (worker.kind = "claude-code"). Nothing needed when the
# machine is logged in to claude.ai; where there is no browser (CI, a server),
# `claude setup-token` prints a one-year subscription token for this variable.
# CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-xxx
# Executable, when `claude` is not on PATH (launchd, CI):
# FACTORY_CLAUDE_BIN=/Users/you/.local/bin/claude

# One-off override of worker.kind, e.g. when the Cursor account is out of usage:
# FACTORY_WORKER=claude-code

# GitHub token override. When unset, the `gh` CLI's own login is used, by the
# factory and by the claude-code worker's agents alike.
# GH_TOKEN=

# Credentials for the coding agents, named in worker.agentEnv in
# factory.config.json. Each is forwarded to every agent (Cursor: session env
# vars on the VM; claude-code: inherited) together with its description, so an
# implementer can run the live test that needs the real service. Unset = not
# handed over, and the tick log says so.
# MODEL_API_KEY=...   # e.g. the model provider key the target app's live tests call
